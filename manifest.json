{
  "manifest_version": 3,
  "name": "alt+A Text Analyzer AI Helper",
  "version": "1.2",
  "description": "Analyzes selected text segments using an LLM to provide explanations.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Text Analyzer Settings"
  }
}
